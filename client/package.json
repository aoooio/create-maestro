{
  "name": "maestro-client",
  "version": "0.1.0",
  "private": true,
  "description": "Client Next.js de Maestro : console Maestro et écran Musicien, synchronisés sur l'horloge du serveur Go.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
